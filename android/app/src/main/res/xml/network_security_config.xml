<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows self-hosted development servers on the local network (http://192.168.x.x).
         Production deployments should be served over HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
