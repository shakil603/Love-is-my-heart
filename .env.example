# ---------------------------------------------------------------------------
# Love Is My Heart (LIMH) — environment
# Copy to .env for local development. Every value is optional: without a
# DATABASE_URL the app uses PGlite (PostgreSQL compiled to WASM) and stores data
# in ./.data/limh, so the app runs with zero external services.
# ---------------------------------------------------------------------------

# A long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-before-you-deploy

# Public origin of the app. Required when you deploy behind a real domain.
# BETTER_AUTH_URL=https://limh.example.com
# NEXT_PUBLIC_APP_URL=https://limh.example.com

# Extra origins allowed to call the auth endpoints (comma separated).
# BETTER_AUTH_TRUSTED_ORIGINS=https://limh.example.com,https://www.limh.example.com

# Use a PostgreSQL server instead of PGlite. Works with any Postgres 14+,
# including the one in docker-compose.yml.
# DATABASE_URL=postgresql://limh:limh@127.0.0.1:5432/limh
# DATABASE_POOL_SIZE=10
# PGLITE_DATA_DIR=./.data/limh

# Seed a clearly labelled sample community so a fresh install is explorable.
# Set to 0 for a production community of real people only.
LIMH_DEMO_MODE=1
# LIMH_DEMO_AUTOREPLY=1
# Optional demo credentials. These only take effect the first time the sample
# community is seeded, before the demo account exists.
# LIMH_DEMO_EMAIL=alex@demo.limh.app
# LIMH_DEMO_PASSWORD=limh-demo-2026

# Optional SMTP for password-reset and email-confirmation links.
# Without SMTP the links are printed to the server log instead.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=limh
# SMTP_PASSWORD=secret
# SMTP_FROM="Love Is My Heart <hello@example.com>"
